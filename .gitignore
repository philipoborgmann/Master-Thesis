# ---------------------------------------------------------------------------
# Local data (never committed). Everything under Data/ and the data-shaped
# parts of Outputs/ is ignored.
# ---------------------------------------------------------------------------
Data/Raw/
Data/Processed/
Data/Transformed/
Data/Features/
Data/Final/

Outputs/Signals/
Outputs/Checkpoints/
Outputs/deskriptiv/
Outputs/diagnostics/
Outputs/Evaluation/

# Transformer checkpoints (large, intermediate)
Data/Transformed/.finbert_checkpoints/
Data/Transformed/.finbert_backup_checkpoints/
Data/Transformed/.cryptobert_checkpoints/
Data/Transformed/.vader_checkpoints/

# ---------------------------------------------------------------------------
# Generic data-file extensions
# (kept broad so accidental commits of raw data are blocked).
# ---------------------------------------------------------------------------
*.parquet
*.csv
*.pkl
*.pt
*.pth
*.zip
*.joblib

# *.xlsx — DO NOT add. feature_sets.xlsx and subreddit_ticker_mapping.xlsx
# are intentionally tracked.

# ---------------------------------------------------------------------------
# Personal / thesis-writing documents (never part of repository execution).
# Policy: this is a code repository — Word / PowerPoint documents are not
# tracked at all. PDFs and images are NOT globally ignored so legitimate
# figures, diagrams or a thesis PDF can be committed deliberately; only known
# personal root documents and local-doc scratch folders are excluded.
# ---------------------------------------------------------------------------
*.docx
*.doc
*.pptx

# Known personal root documents (manuscript appendices, admission form).
/Anhang_*.docx
/Antrag_*.pdf

# Local-only scratch / rendered / private document folders.
/private/
/local_docs/
/rendered/
/artifacts/
/tmp/

# Developer-only repo snapshot (regenerated locally, never tracked).
repo_context.md
create_repo_context.py

# ---------------------------------------------------------------------------
# Build artifacts, logs, temporaries, secrets
# ---------------------------------------------------------------------------
*.egg-info/
build/
dist/
*.log
*.tmp
*.bak
.env
.env.*

# ---------------------------------------------------------------------------
# Python / IDE
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

.idea/
.vscode/
.DS_Store

# ---------------------------------------------------------------------------
# Exceptions: tiny tracked fixtures and metadata
# ---------------------------------------------------------------------------
!feature_sets.xlsx
!subreddit_ticker_mapping.xlsx
!tests/fixtures/**

# Compact final result tables + run manifest for examiners (small, curated).
# *.csv / *.json are globally ignored above; re-include ONLY this directory.
!results/final/
!results/final/*.csv
!results/final/*.json
